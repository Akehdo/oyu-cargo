[Unit]
Description=Renew CRM TLS certificate and reload Docker nginx
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/crm-certbot.env
ExecStart=/bin/bash /usr/local/lib/crm-certbot/renew-certificates.sh
TimeoutStartSec=1h
