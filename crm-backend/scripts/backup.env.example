CRM_COMPOSE_DIR=/opt/crm/crm-backend
CRM_BACKUP_DIR=/var/backups/crm/postgres
# local: server-only dumps without rclone; gdrive: also upload to Google Drive.
CRM_BACKUP_MODE=gdrive
CRM_BACKUP_REMOTE=gdrive:CRM-backups/postgres
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# Local archives older than this many days are deleted (gdrive mode: only after
# a verified upload; the newest archive is always kept). 0 disables pruning.
CRM_BACKUP_KEEP_DAYS=14
# Remote archives older than this are deleted from the remote folder. 0 = keep all.
CRM_BACKUP_REMOTE_KEEP_DAYS=90
# Encryption: dumps contain password hashes and client phones. Create an rclone
# "crypt" remote on top of the Google Drive remote (rclone config → crypt,
# remote = gdrive:CRM-backups-encrypted) and point CRM_BACKUP_REMOTE at it, e.g.
# CRM_BACKUP_REMOTE=gdrive-crypt:postgres
